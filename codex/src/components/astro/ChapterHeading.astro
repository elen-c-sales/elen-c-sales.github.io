---
// src/components/astro/ChapterHeading.astro — Cabeçalho de capítulo
interface Props {
  number: string;
  title: string;
  subtitle?: string;
  icon?: string;
}

const { number, title, subtitle, icon } = Astro.props;
---

<section class="chapter-heading" style="margin: var(--space-8) 0 var(--space-6); padding-bottom: var(--space-4); border-bottom: 2px solid var(--line); position: relative;">
  <div style="display: flex; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-2);">
    <span class="chapter-number" style="
      font-family: var(--font-hud);
      font-size: var(--text-2xl);
      color: var(--accent);
      text-shadow: var(--shadow-1);
    ">
      {number}
    </span>
    <div>
      <h2 class="chapter-title" style="
        font-family: var(--font-display);
        font-size: var(--text-3xl);
        font-weight: 600;
        color: var(--ink);
        line-height: 1.2;
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
        flex-wrap: wrap;
      ">
        {icon && <i class={icon} style="font-size: var(--text-2xl); color: var(--accent);"></i>}
        {title}
      </h2>
      {subtitle && (
        <p class="chapter-subtitle" style="
          color: var(--ink-soft);
          font-size: var(--text-lg);
          margin-top: var(--space-1);
          font-style: italic;
        ">
          {subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- Linha decorativa -->
  <div style="
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 60px;
    height: 4px;
    background: var(--accent);
    box-shadow: var(--shadow-1);
  "></div>
</section>

<style>
  .chapter-heading::before {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 60px;
    right: 0;
    height: 2px;
    background: var(--line);
  }
</style>