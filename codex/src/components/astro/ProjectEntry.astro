---
// src/components/astro/ProjectEntry.astro — Card do Bestiário
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;

const familyIcons: Record<string, string> = {
  jogos: 'fas fa-gamepad',
  dados: 'fas fa-chart-line',
  web: 'fas fa-globe',
  visao: 'fas fa-eye',
};

const familyLabels: Record<string, string> = {
  jogos: 'Jogos & Pixel',
  dados: 'Dados',
  web: 'Web & Apps',
  visao: 'Visão',
};

const statusLabels: Record<string, string> = {
  enviado: 'Publicado',
  'em-obras': 'Em andamento',
  arquivado: 'Arquivado',
};

const statusColors: Record<string, string> = {
  enviado: 'var(--p-mint)',
  'em-obras': 'var(--p-candle)',
  arquivado: 'var(--ink-soft)',
};
---

<article
  class="codex-card"
  data-family={data.family}
  data-status={data.status}
  data-featured={data.featured}
  data-order={data.order}
  style="
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--dur-med) var(--ease), box-shadow var(--dur-med) var(--ease);
  "
  onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-2)'"
  onmouseout="this.style.transform='none'; this.style.boxShadow='var(--shadow-1)'"
>
  <!-- Cover -->
  {data.cover && (
    <div style="margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) var(--space-4); position: relative; overflow: hidden;">
      <img
        src={data.cover}
        alt={data.coverAlt || `Capa de ${data.title}`}
        style="width: 100%; height: 180px; object-fit: cover; transition: transform var(--dur-med) var(--ease);"
        onmouseover="this.style.transform='scale(1.02)'"
        onmouseout="this.style.transform='scale(1)'"
        loading="lazy"
        onerror="this.onerror=null; this.src='https://placehold.co/800x450/1e182a/8a7bff?text=Imagem+indispon%C3%ADvel'"
      />
      <div style="
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
      ">
        <span
          style="
            background: var(--paper);
            color: var(--accent);
            padding: var(--space-1) var(--space-3);
            border: 2px solid var(--line-strong);
            font-family: var(--font-hud);
            font-size: var(--text-xs);
            text-transform: uppercase;
          "
        >
          {familyLabels[data.family] || data.family}
        </span>
        <span
          style="
            background: var(--paper);
            color: {statusColors[data.status]};
            padding: var(--space-1) var(--space-3);
            border: 2px solid var(--line-strong);
            font-family: var(--font-hud);
            font-size: var(--text-xs);
          "
        >
          {statusLabels[data.status] || data.status}
        </span>
      </div>
    </div>
  )}

  <!-- Content -->
  <div style="flex: 1; display: flex; flex-direction: column;">
    <header style="margin-bottom: var(--space-3);">
      <h3 style="
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: 600;
        color: var(--ink);
        margin-bottom: var(--space-2);
        line-height: 1.3;
      ">
        {data.title}
      </h3>
      <p style="
        color: var(--ink-soft);
        font-size: var(--text-sm);
        line-height: 1.5;
        margin: 0;
      ">
        {data.tagline}
      </p>
    </header>

    <!-- Tech tags -->
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
      {data.tech.slice(0, 6).map(tech => (
        <span
          style="
            background: var(--paper-2);
            color: var(--ink-soft);
            padding: var(--space-1) var(--space-2);
            border: 1px solid var(--line);
            font-family: var(--font-body);
            font-size: var(--text-xs);
            font-weight: 500;
            transition: all var(--dur-fast) var(--ease);
          "
          onmouseover="this.style.background='var(--accent)'; this.style.color='var(--on-accent)'; this.style.borderColor='var(--accent)'"
          onmouseout="this.style.background='var(--paper-2)'; this.style.color='var(--ink-soft)'; this.style.borderColor='var(--line)'"
        >
          {tech}
        </span>
      ))}
      {data.tech.length > 6 && (
        <span style="
          background: var(--paper-2);
          color: var(--ink-soft);
          padding: var(--space-1) var(--space-2);
          border: 1px solid var(--line);
          font-family: var(--font-hud);
          font-size: var(--text-xs);
        ">
          +{data.tech.length - 6}
        </span>
      )}
    </div>

    <!-- Arcane note (marginalia) -->
    {data.arcaneNote && (
      <div class="marginalia" style="margin-bottom: var(--space-4); font-size: var(--text-xs);">
        {data.arcaneNote}
      </div>
    )}

    <!-- Actions -->
    <footer style="margin-top: auto; display: flex; gap: var(--space-2); flex-wrap: wrap;">
      {data.links.repo && (
        <a
          href={data.links.repo}
          target="_blank"
          rel="noopener"
          class="btn-codex"
          style="display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none;"
        >
          <i class="fab fa-github" style="font-size: var(--text-base);"></i>
          <span>Código</span>
        </a>
      )}
      {data.links.demo && (
        <a
          href={data.links.demo}
          target="_blank"
          rel="noopener"
          class="btn-codex"
          style="
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            text-decoration: none;
            background: var(--accent);
            color: var(--on-accent);
            border-color: var(--accent);
          "
        >
          <i class="fas fa-external-link-alt" style="font-size: var(--text-base);"></i>
          <span>Demo</span>
        </a>
      )}
      <a
        href={`/projetos/${project.id}`}
        class="btn-codex"
        style="display: inline-flex; align-items: center; gap: var(--space-2); text-decoration: none; flex: 1; justify-content: center;"
      >
        <i class="fas fa-book-open" style="font-size: var(--text-base);"></i>
        <span>Ver projeto</span>
      </a>
    </footer>
  </div>
</article>