---
// src/pages/arcanum.astro — Página secreta (noindex)
import Codex from '../components/astro/Codex.astro';
import ChapterHeading from '../components/astro/ChapterHeading.astro';
import Marginalia from '../components/astro/Marginalia.astro';
import '../styles/global.css';
---

<Codex
  title="Arcanum — Códice"
  description="Página secreta do códice. Acesso restrito a iniciados."
  noIndex={true}
>
  <!-- Meta noindex já no BaseHead via noIndex prop -->

  <article style="max-width: 800px; margin: 0 auto; padding: var(--space-8) var(--space-4); text-align: center;">
    <ChapterHeading number="??"
      title="Arcanum"
      subtitle="Conhecimento proibito aos não-iniciados"
      icon="fas fa-skull" />

    <div style="margin: var(--space-8) 0;">
      <div style="
        font-family: var(--font-hud);
        font-size: clamp(var(--text-2xl), 8vw, var(--text-4xl));
        color: var(--accent);
        text-shadow: var(--shadow-2);
        animation: pulse 2s infinite;
        margin-bottom: var(--space-4);
      ">
        ⟠ ARCANUM ⟠
      </div>
    </div>

    <Marginalia size="md" style="max-width: 600px; margin: 0 auto var(--space-8);">
      "O códice guarda segredos que só os persistentes encontram.
      A tecla <kbd style='font-family: var(--font-hud); background: var(--paper-2); padding: 0 var(--space-1); border: 1px solid var(--line);'>~</kbd> abre o terminal.
      O código antigo <kbd style='font-family: var(--font-hud); background: var(--paper-2); padding: 0 var(--space-1); border: 1px solid var(--line);'>↑↑↓↓←→←→BA</kbd> revela o vazio.
      O diabrete no prólogo aguarda cinco toques.
      O sigilo no rodapé guarda a entrada.
      A meia-noite, o grimório muda."
    </Marginalia>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); margin: var(--space-8) 0;">
      <div class="codex-card" style="padding: var(--space-5);">
        <i class="fas fa-terminal" style="font-size: var(--text-3xl); color: var(--accent); margin-bottom: var(--space-3); display: block;"></i>
        <h3 style="font-family: var(--font-display); color: var(--ink); margin-bottom: var(--space-2);">Terminal</h3>
        <p style="color: var(--ink-soft); font-size: var(--text-sm);">Digite <code>help</code> para comandos. <code>ls</code> lista projetos. <code>theme void</code> força o tema secreto.</p>
      </div>
      <div class="codex-card" style="padding: var(--space-5);">
        <i class="fas fa-ghost" style="font-size: var(--text-3xl); color: var(--p-mint); margin-bottom: var(--space-3); display: block;"></i>
        <h3 style="font-family: var(--font-display); color: var(--ink); margin-bottom: var(--space-2);">Diabrete</h3>
        <p style="color: var(--ink-soft); font-size: var(--text-sm);">O familiar do códice. Clique 5 vezes no prólogo. Ele lembra de você entre sessões.</p>
      </div>
      <div class="codex-card" style="padding: var(--space-5);">
        <i class="fas fa-moon" style="font-size: var(--text-3xl); color: var(--p-candle); margin-bottom: var(--space-3); display: block;"></i>
        <h3 style="font-family: var(--font-display); color: var(--ink); margin-bottom: var(--space-2);">Meia-Noite</h3>
        <p style="color: var(--ink-soft); font-size: var(--text-sm);">Entre 00:00 e 01:00, o códice sussurra. Visite nessa hora para um toast especial.</p>
      </div>
    </div>

    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 2px solid var(--line);">
      <p style="font-family: var(--font-hud); font-size: var(--text-xs); color: var(--ink-soft);">
        Você encontrou esta página. O códice registra sua presença.
      </p>
      <a href="/" class="btn-codex" style="margin-top: var(--space-4); display: inline-flex;">
        <i class="fas fa-arrow-left"></i> Retornar ao Bestiário
      </a>
    </div>
  </article>

  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
  </style>

  <script type="module">
    // Registra evento 'arcanum-read' para conquista
    if (typeof window !== 'undefined') {
      setTimeout(() => {
        const event = new CustomEvent('codex:arcanum-read');
        window.dispatchEvent(event);
      }, 500);
    }
  </script>
</Codex>