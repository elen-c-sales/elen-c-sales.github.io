{
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@lib/*": ["src/lib/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"]
    },
    "types": ["vite/client", "astro/client"]
  },
  "include": ["src/**/*", ".astro/types.d.ts", "*.astro"],
  "exclude": ["dist", "node_modules"]
}